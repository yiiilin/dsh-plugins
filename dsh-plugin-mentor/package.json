{
  "name": "@yiln-dsh/dsh-plugin-mentor",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH bundle plugin with an isolated Mentor Agent tool, session-scoped history, and one global settings page.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/mentor.js",
    "lib/protocol.js",
    "lib/journal.js",
    "cordis.patch.yml",
    "README.md",
    "TESTING.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.5-rc.2 <0.1.6 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/schemastery": ">=1.0.0",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
