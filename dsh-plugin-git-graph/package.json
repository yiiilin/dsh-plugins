{
  "name": "@yiln-dsh/dsh-plugin-git-graph",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH Web bundle plugin that contributes a Git Graph page tab to the DSH Web right Sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": ">=0.1.5-rc.1 <0.1.6 || >=0.1.6-alpha.2 <0.1.6-alpha.3 || >=0.1.7-alpha.2 <0.1.7-alpha.3 || >=0.1.7-rc.1 <0.1.7-rc.2"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "monaco-editor": "^0.56.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
