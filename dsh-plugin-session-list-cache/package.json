{
  "name": "@yiln-dsh/dsh-plugin-session-list-cache",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH bundle plugin that collapses the repeated full-store session enumerations the Web GUI fires concurrently, by caching and coalescing sessionQuery.listSessions().",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
