{
  "name": "@yiln-dsh/dsh-plugin-llm-adapter",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local fork of DSH's llm-pi-ai adapter with per-model reasoning and OpenAI Responses service-tier settings.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./invariant": "./lib/invariant.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/settings-patch.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-authorization": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-modules": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-models": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@earendil-works/pi-ai": ">=0.82.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
