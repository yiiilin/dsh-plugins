{
  "name": "@yiln-dsh/dsh-plugin-auth-webserver",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH web bundle: an auth-gated reverse proxy on every non-loopback NIC that forwards to the stock 127.0.0.1 web server.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "policy.js",
    "login-page.js",
    "mobile.js",
    "pwa.js",
    "session-store.js",
    "settings-editor.js",
    "passkey-store.js",
    "pwa",
    "totp.js",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "js-yaml": "4.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
