{
  "name": "dsh-plugin-auth-webserver",
  "version": "0.1.0",
  "description": "DSH web bundle that binds 0.0.0.0 and gates the GUI with HTTP Basic Auth and an HMAC login cookie.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
