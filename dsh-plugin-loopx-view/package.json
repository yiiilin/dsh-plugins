{
  "name": "@yiln-dsh/dsh-plugin-loopx-view",
  "version": "0.1.0",
  "description": "Session-scoped LoopX Goal and execution view for the DSH Conversation tabs.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "test"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
