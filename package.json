{
  "name": "yiln-dsh-plugins-workspace",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Workspace of independently installable DeepSeek Harness plugins. Each package lives under pkgs/ and mounts its own dsh.bundle layer, so a profile installs only the plugins it needs.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js pkgs/*/test/*.test.js",
    "test:editor": "node --test pkgs/auth-webserver/test/e2e/settings-editor.test.js",
    "test:modes:browser": "node --test pkgs/session-mode/test/e2e/modes.test.js",
    "migrate": "node scripts/migrate-profile.mjs"
  },
  "devDependencies": {
    "js-yaml": "4.3.2",
    "yaml": "^2.8.1"
  }
}
