{
  "name": "@yiln-dsh/dsh-plugin-web-browser",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH Web bundle plugin that adds a server-side browser view next to the terminal: Chromium runs on the DSH host, frames stream back via CDP screencast over WebSocket, and mouse/keyboard input is injected back.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0-rc.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
