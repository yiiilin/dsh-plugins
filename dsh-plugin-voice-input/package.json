{
  "name": "@yiln-dsh/dsh-plugin-voice-input",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH Web bundle plugin that adds two-pass local voice input to the composer: a realtime model while speaking, a non-realtime model that corrects the transcript afterwards.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "offline-worker.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "sherpa-onnx-node": "^1.13.7",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
