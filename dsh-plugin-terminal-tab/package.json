{
  "name": "@yiln-dsh/dsh-plugin-terminal-tab",
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH Web bundle plugin that adds per-session persistent terminal tabs.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
