{
  "name": "@yiln-dsh/dsh-code-server",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "files": [
    "index.js",
    "instances.js",
    "proxy.js",
    "detect.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "!**/test/"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "main": "index.js"
}
