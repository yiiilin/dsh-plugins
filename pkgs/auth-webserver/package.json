{
  "name": "@yiln-dsh/dsh-auth-webserver",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "files": [
    "client.js",
    "core-session.js",
    "index.d.ts",
    "index.js",
    "login-page.js",
    "mobile.js",
    "passkey-store.js",
    "policy.js",
    "pwa",
    "pwa.js",
    "session-store.js",
    "settings-client-patch.js",
    "settings-editor.js",
    "totp.js",
    "cordis.patch.yml",
    "README.md",
    "!**/test/"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "main": "index.js",
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "js-yaml": "4.3.2"
  }
}
