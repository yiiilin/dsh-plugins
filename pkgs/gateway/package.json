{
  "name": "@yiln-dsh/dsh-gateway",
  "version": "0.7.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "description": "Single entry, authentication, profile routing and SSH deployment for a DeepSeek Harness host",
  "files": [
    "client.js",
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "!**/test/"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "main": "index.js"
}
